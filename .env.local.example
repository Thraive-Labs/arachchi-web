# Supabase — Canada Central project
# Found at: supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Postgres — found at: supabase.com -> Project Settings -> Database -> Connection string (URI mode)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Stripe — found at: dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend — found at: resend.com -> API Keys
RESEND_API_KEY=re_...

# Site URL — no trailing slash
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron — any random secret to authenticate the /api/cron/trending endpoint
CRON_SECRET=your_random_secret_here

# Sentry — found at: sentry.io -> Settings -> Projects -> Client Keys
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
